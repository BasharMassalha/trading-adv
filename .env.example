# ============================================================================
# Trading Adv — environment variables
# Copy this file to `.env` for local dev, and configure the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# ============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Use a pooled connection string in production (e.g. Vercel Postgres / Neon).
DATABASE_URL="postgresql://user:1212@localhost:5432/trading_adv?schema=public"

# Optional direct (non-pooled) URL, used by Prisma migrations on some providers.
DIRECT_URL="postgresql://user:1212@localhost:5432/trading_adv?schema=public"

# --- Auth --------------------------------------------------------------------
# 32+ char random string. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Trading Adv"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OpenAI API Key ----------------------------------------------------------
# Required for:
#   - Vision-based portfolio screenshot extraction (VISION_PROVIDER=openai)
#   - AI advisor analysis (ANALYSIS_PROVIDER=openai)
#   - AI advisor chat (ANALYSIS_PROVIDER=openai)
#
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# --- AI Analysis provider (for portfolio advisor) ----------------------------
# Controls which AI model is used for portfolio analysis reports and chat.
#
# Available options:
#   "mock"   - Use rule-based mock analysis (default, no API key required)
#   "openai" - Use OpenAI GPT models (requires OPENAI_API_KEY)
#
ANALYSIS_PROVIDER="mock"

# --- AI Model configuration --------------------------------------------------
# Configure which OpenAI models to use for analysis and chat.
# Only used when ANALYSIS_PROVIDER="openai"
#
# OPENAI_ANALYSIS_MODEL: Model for portfolio analysis reports
#   Default: "gpt-4o" (recommended for best quality)
#   Options: "gpt-4o", "gpt-4o-mini", "gpt-4-turbo", "gpt-3.5-turbo"
#
# OPENAI_CHAT_MODEL: Model for advisor chat conversations
#   Default: "gpt-4o" (recommended for best quality)
#   Options: "gpt-4o", "gpt-4o-mini", "gpt-4-turbo", "gpt-3.5-turbo"
#
# Note: gpt-4o-mini is faster and cheaper but may produce lower quality analysis.
# Note: gpt-4o is recommended for the best analysis quality.
#
# OPENAI_ANALYSIS_MODEL="gpt-4o"
# OPENAI_CHAT_MODEL="gpt-4o"

# --- Vision provider (for screenshot portfolio import) -----------------------
# Controls which vision model is used to extract holdings from screenshots.
#
# Available options:
#   "auto"   - Auto-detect: uses OpenAI if OPENAI_API_KEY is set, else mock
#   "openai" - Use OpenAI GPT-4 Vision (requires OPENAI_API_KEY)
#   "mock"   - Use static mock data (for development/testing/demos)
#
# The default is "auto", which automatically enables real vision when
# OPENAI_API_KEY is configured.
#
# OpenAI Vision provides:
#   - Extraction from brokerage screenshots (Fidelity, Schwab, etc.)
#   - Structured JSON output with holdings data
#   - Support for PNG, JPG, and WebP images
#   - Note: Token-based pricing applies for image processing
#
VISION_PROVIDER="auto"

# --- Market data provider ----------------------------------------------------
# Controls which market data source is used for portfolio enrichment.
#
# Available options:
#   "auto"   - Use Yahoo Finance (default, no API key required)
#   "yahoo"  - Explicitly use Yahoo Finance
#   "mock"   - Use static mock data (for development/testing/demos)
#
# The default is "auto", which uses Yahoo Finance for real market data.
# Yahoo Finance provides:
#   - Real-time quotes
#   - Company/ETF profiles with sector, industry info
#   - Historical daily prices (up to 5 years)
#   - No API key required (informal rate limits apply)
#
MARKET_DATA_PROVIDER="auto"

# For future premium providers (Polygon.io, Alpha Vantage, etc.):
# MARKET_DATA_API_KEY=""

# --- News provider (for portfolio intelligence) ------------------------------
# Controls which news source is used for portfolio holdings context.
#
# Available options:
#   "mock"    - Use static mock news data (default, no API key required)
#   "finnhub" - Use Finnhub API (requires NEWS_API_KEY)
#
# The default is "mock", which uses realistic but static news data.
#
# Finnhub provides:
#   - Company news for stocks
#   - Recent headlines and summaries
#   - Free tier: 60 API calls/minute
#   - Get your API key at: https://finnhub.io/
#
NEWS_PROVIDER="mock"

# Finnhub API key (required when NEWS_PROVIDER="finnhub")
# Get your free API key at: https://finnhub.io/
# NEWS_API_KEY=""

# --- SEC Filings provider (for portfolio intelligence) -----------------------
# Controls which source is used for SEC filings retrieval.
#
# Available options:
#   "mock" - Use static mock filings data (default)
#   "sec"  - Use SEC EDGAR public API (no API key required)
#
# The default is "mock", which uses realistic but static filings data.
#
# SEC EDGAR provides:
#   - 10-K, 10-Q, 8-K and other SEC filings
#   - Official company disclosures
#   - No API key required (public data)
#   - Rate limit: ~10 requests/second
#
FILINGS_PROVIDER="mock"
